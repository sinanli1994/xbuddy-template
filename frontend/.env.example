# JobBuddy demo frontend — placeholders only, never real values.
#
# Both are SERVER-ONLY. Neither is prefixed NEXT_PUBLIC_, so Next.js will not
# inline them into the browser bundle. The browser never learns the bearer token:
# it calls /api/chat and /api/history, and those server routes attach the header.

JOBBUDDY_API_URL=https://jobbuddy-api.fly.dev
JOBBUDDY_API_TOKEN=your-fly-auth-secret

# Optional. Set to "local" to point at a backend on http://localhost:8080 instead.
# Not a secret — it selects a URL, it does not carry one.
NEXT_PUBLIC_API_ENV=production
JOBBUDDY_API_URL_LOCAL=http://localhost:8080
